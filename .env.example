# Copy to ".env" and fill in. Never share ".env".
RPC_HTTP_URL=          # private RPC, free Helius key works: https://dashboard.helius.dev
TOKEN_MINT=            # your token address
TOKEN_SYMBOL=          # e.g. BONK
MIN_USD=50             # smallest buy that triggers an alert
PLATFORM=telegram      # telegram or discord

TELEGRAM_BOT_TOKEN=    # from @BotFather
TELEGRAM_CHAT_ID=      # your group id, starts with -100
DISCORD_WEBHOOK=       # Channel settings > Integrations > Webhooks > Copy URL
